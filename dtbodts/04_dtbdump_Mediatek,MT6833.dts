					vbmeta {
						compatible = "android,vbmeta";
						parts = "vbmeta,boot,system,vendor,product,odm,prism,optics,vbmeta_system,recovery,lk,tee1";
					};
				};
			};

			shub {
				acc-lsm6dsl-position = <0x0>;
				acc-motor-coef = <0x14>;
				compatible = "shub";
				mag-ak09918c-array = [b1 4f 9d f3 5b e6 00 e7 d5 35 60 5b c3 e4 fe d7 ff 3f 32 16 be f9 9a 34 0b e7 fb];
				mag-ak09918c-position = <0x2>;
			};

			usb_notifier {
				compatible = "samsung,usb-notifier";
				disable_host_wakelock;
			};

			usb_tuning {
				compatible = "mediatek,phy_tuning";
				phandle = <0x9b>;

				tune@1 {
					label = "term_vref_sel";
					mask = <0x7>;
					offset = <0x4>;
					shift = <0x8>;
					value = <0x2>;
				};

				tune@2 {
					label = "vrt_ref_sel";
					mask = <0x7>;
					offset = <0x4>;
					shift = <0xc>;
					value = <0x3>;
				};

				tune@3 {
					label = "intr_cal";
					mask = <0x1f>;
					offset = <0x4>;
					shift = <0x13>;
					value = <0x19>;
				};

				tune@4 {
					label = "hstx_srctrl";
					mask = <0x7>;
					offset = <0x14>;
					shift = <0xc>;
					value = <0x1>;
				};

				tune@5 {
					label = "hstx_srcal_en";
					mask = <0x1>;
					offset = <0x14>;
					shift = <0xf>;
					value = <0x0>;
				};

				tune@6 {
					label = "sqth";
					mask = <0xf>;
					offset = <0x18>;
					shift = <0x0>;
					value = <0x2>;
				};

				tune@7 {
					label = "discth";
					mask = <0xf>;
					offset = <0x18>;
					shift = <0x4>;
					value = <0x7>;
				};

				tune@8 {
					label = "enhance";
					mask = <0x3>;
					offset = <0x18>;
					shift = <0x1e>;
					value = <0x3>;
				};
			};
		};
	};

