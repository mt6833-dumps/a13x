	fragment@lcd {
		target-path = [2f 00];

		__overlay__ {

			__nt36525c_sharp_90 {
				drm_params-vrefresh = <0x5a>;
				lcm_params-dsi-vertical_frontporch = <0x1c>;
				phandle = <0x8f>;
			};

			__td4160_boe_90 {
				drm_params-vrefresh = <0x5a>;
				lcm_params-dsi-vertical_frontporch = <0x96>;
				phandle = <0x8c>;
			};

			lcd_fixed_regulator {
				compatible = "simple-bus";
				phandle = <0xbc>;

				__gpio_lcd_bl_en {
					compatible = "regulator-fixed";
					enable-active-high;
					gpio = <0xffffffff 0x8a 0x0>;
					phandle = <0xbe>;
					regulator-boot-on;
					regulator-name = "gpio_lcd_bl_en";
				};

				__gpio_lcd_rst {
					compatible = "regulator-fixed";
					enable-active-high;
					gpio = <0xffffffff 0x56 0x0>;
					phandle = <0xbd>;
					regulator-boot-on;
					regulator-name = "gpio_lcd_rst";
				};
			};

			nt36525c_sharp {
				drm_params-vrefresh = <0x3c>;
				ext_params-dyn_fps-vact_timing_fps = <0x5a>;
				id_match = <0xffffff 0x2af244>;
				lcm_params-dsi-cont_clock = <0x1>;
				lcm_params-dsi-data_rate = <0x4ae>;
				lcm_params-dsi-horizontal_backporch = <0x22>;
				lcm_params-dsi-horizontal_frontporch = <0x18>;
				lcm_params-dsi-horizontal_sync_active = <0x2>;
				lcm_params-dsi-lane_num = <0x3>;
				lcm_params-dsi-mode = <0x2>;
				lcm_params-dsi-ssc_disable = <0x1>;
				lcm_params-dsi-vertical_backporch = <0x14a>;
				lcm_params-dsi-vertical_frontporch = <0x3f0>;
				lcm_params-dsi-vertical_sync_active = <0x2>;
				lcm_params-physical_height = <0x97>;
				lcm_params-physical_width = <0x44>;
				lcm_params-resolution = <0x2d0 0x640>;
				lcm_params-types = <0x2>;
				phandle = <0x8e>;
				smcdsd_board = <0x90>;
				vrr_info = <0x8e 0x8f>;
			};

			panel {
				compatible = "samsung,mtk-dsi-panel";
				smcdsd_panel = <0x8b>;
			};

			smcdsd_board_nt36525c {
				gpio_con = <0xffffffff 0x2d 0x0>;
				phandle = <0x90>;

				panel_power_disable {
					type = "delay,usleep", "3000", "regulator,disable", "gpio_lcd_bl_en", "delay,usleep", "5000", "regulator,disable", "vcamio", "delay,msleep", "33";
				};

				panel_power_enable {
					type = "regulator,enable", "vcamio", "delay,usleep", "2000", "regulator,enable", "gpio_lcd_bl_en", "delay,usleep", "2000";
				};

				panel_regulator_init {
					type = "regulator,enable", "vcamio", "regulator,enable", "gpio_lcd_rst", "regulator,enable", "gpio_lcd_bl_en";
				};

				panel_reset_disable {
					type = "delay,msleep", "60", "regulator,disable", "gpio_lcd_rst", "delay,usleep", "5000";
				};

				panel_reset_enable {
					type = "delay,usleep", "10000", "regulator,enable", "gpio_lcd_rst", "delay,usleep", "5000", "regulator,disable", "gpio_lcd_rst", "delay,usleep", "3500", "regulator,enable", "gpio_lcd_rst", "delay,usleep", "10000";
				};
			};

			smcdsd_board_td4160 {
				gpio_con = <0xffffffff 0x2d 0x0>;
				phandle = <0x8d>;

				panel_power_disable {
					type = "delay,usleep", "3000", "regulator,disable", "gpio_lcd_bl_en", "delay,usleep", "5000", "regulator,disable", "vcamio", "delay,usleep", "15000";
				};

				panel_power_enable {
					type = "regulator,enable", "vcamio", "delay,usleep", "1000", "regulator,enable", "gpio_lcd_bl_en", "delay,usleep", "1000";
				};

				panel_regulator_init {
					type = "regulator,enable", "vcamio", "regulator,enable", "gpio_lcd_rst", "regulator,enable", "gpio_lcd_bl_en";
				};

				panel_reset_disable {
					type = "delay,msleep", "70", "regulator,disable", "gpio_lcd_rst", "delay,usleep", "10000";
				};

				panel_reset_enable {
					type = "delay,usleep", "1000", "regulator,enable", "gpio_lcd_rst", "delay,usleep", "2000", "regulator,disable", "gpio_lcd_rst", "delay,usleep", "2000", "regulator,enable", "gpio_lcd_rst", "delay,msleep", "20";
				};
			};

			td4160_boe {
				drm_params-vrefresh = <0x3c>;
				ext_params-dyn_fps-vact_timing_fps = <0x5a>;
				id_match = <0xffffff 0x2a6220>;
				lcm_params-dsi-cont_clock = <0x1>;
				lcm_params-dsi-data_rate = <0x342>;
				lcm_params-dsi-horizontal_backporch = <0x14>;
				lcm_params-dsi-horizontal_frontporch = <0x40>;
				lcm_params-dsi-horizontal_sync_active = <0x2>;
				lcm_params-dsi-lane_num = <0x4>;
				lcm_params-dsi-mode = <0x3>;
				lcm_params-dsi-ssc_disable = <0x1>;
				lcm_params-dsi-vertical_backporch = <0xc>;
				lcm_params-dsi-vertical_frontporch = <0x409>;
				lcm_params-dsi-vertical_sync_active = <0x4>;
				lcm_params-physical_height = <0x97>;
				lcm_params-physical_width = <0x44>;
				lcm_params-resolution = <0x2d0 0x640>;
				lcm_params-types = <0x2>;
				phandle = <0x8b>;
				smcdsd_board = <0x8d>;
				vrr_info = <0x8b 0x8c>;
			};
		};
	};

